// Main Calculation Logic
// =====================================================

/**
 * Main harmonic pattern detection function
 * 
 * This function coordinates the overall pattern recognition process,
 * from finding pivot points to validating patterns.
 */
detect_harmonic_patterns() =>
    // Detection logic for harmonic patterns
    // Current implementation uses a modular approach with specialized functions

// Process patterns to generate signals
signal = process_pattern_trading_signals()

// Display the signal if valid
if is_valid_signal(signal)
    draw_signal_label(signal)

// =====================================================
// Alert Logic
// =====================================================
/**
 * This section handles alert generation based on detected patterns and signals.
 * Alerts are triggered according to user-defined criteria and thresholds.
 */

// Generate alerts for valid trading signals
if alert_trade_points and is_valid_signal(signal) and signal.quality >= min_quality_for_alert
    alert_message = get_signal_text(signal)
    alert(alert_message, alert.freq_once_per_bar)

// =====================================================
// Chart Information Display
// =====================================================
/**
 * This section manages the display of supplementary information on the chart,
 * including error statistics and debugging information when enabled.
 */

// Display error statistics when enabled
if show_error_stats and barstate.islast
    stats_text = "Errors: " + str.tostring(total_errors) + 
                 " | Recovered: " + str.tostring(recovered_errors)
    
    if last_error_message != ""
        stats_text := stats_text + "\nLast Error: " + last_error_message
    
    label.new(
        bar_index, low, 
        stats_text, 
        style=label.style_label_up,
        color=color.new(color.gray, 80),
        textcolor=color.white,
        size=size.small)

// =====================================================
// Harmonic Pattern Validation
// =====================================================

/**
 * Validate Bat pattern
 * 
 * @param x_price X point price
 * @param a_price A point price 
 * @param b_price B point price
 * @param c_price C point price
 * @param tolerance Tolerance for ratio validation
 * @returns Array containing [is_valid, d_price]
 */
validate_bat_pattern(float x_price, float a_price, float b_price, float c_price, float tolerance = DEFAULT_TOLERANCE) =>
    is_valid = false
    d_price = 0.0
    
    // Calculate key moves
    xa = a_price - x_price
    ab = b_price - a_price
    bc = c_price - b_price
    
    // Check key ratios for bat pattern
    // Bat pattern key ratios:
    // - AB = 0.382-0.5 of XA
    // - BC = 0.382-0.886 of AB
    // - CD = 1.618-2.618 of BC
    // - D = 0.886 retracement of XA
    
    ab_xa_ratio = calculate_ratio(xa, ab)
    bc_ab_ratio = calculate_ratio(ab, bc)
    
    // Validate AB/XA ratio (should be between 0.382-0.5)
    ab_xa_valid = validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_382, tolerance) or 
                  validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_5, tolerance) or
                  (ab_xa_ratio > FIB_LEVEL_382 - tolerance and ab_xa_ratio < FIB_LEVEL_5 + tolerance)
    
    // Validate BC/AB ratio (should be between 0.382-0.886)
    bc_ab_valid = validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_382, tolerance) or
                  validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_786, tolerance) or
                  (bc_ab_ratio > FIB_LEVEL_382 - tolerance and bc_ab_ratio < FIB_LEVEL_786 + tolerance)
    
    // Calculate D point (0.886 retracement of XA)
    d_price := a_price - xa * FIB_LEVEL_886
    
    // Check overall pattern validity
    is_valid := ab_xa_valid and bc_ab_valid
    
    [is_valid, d_price]

/**
 * Validate Butterfly pattern
 * 
 * @param x_price X point price
 * @param a_price A point price 
 * @param b_price B point price
 * @param c_price C point price
 * @param tolerance Tolerance for ratio validation
 * @returns Array containing [is_valid, d_price]
 */
validate_butterfly_pattern(float x_price, float a_price, float b_price, float c_price, float tolerance = DEFAULT_TOLERANCE) =>
    is_valid = false
    d_price = 0.0
    
    // Calculate key moves
    xa = a_price - x_price
    ab = b_price - a_price
    bc = c_price - b_price
    
    // Butterfly pattern key ratios:
    // - AB = 0.786 of XA
    // - BC = 0.382-0.886 of AB
    // - CD = 1.618-2.618 of BC
    // - D = 1.27-1.618 extension of XA
    
    ab_xa_ratio = calculate_ratio(xa, ab)
    bc_ab_ratio = calculate_ratio(ab, bc)
    
    // Validate AB/XA ratio (should be around 0.786)
    ab_xa_valid = validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_786, tolerance)
    
    // Validate BC/AB ratio (should be between 0.382-0.886)
    bc_ab_valid = validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_382, tolerance) or
                  validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_886, tolerance) or
                  (bc_ab_ratio > FIB_LEVEL_382 - tolerance and bc_ab_ratio < FIB_LEVEL_886 + tolerance)
    
    // Calculate D point (1.27-1.618 extension of XA)
    // Using average of the range for simplicity
    d_price := a_price - xa * FIB_LEVEL_1272
    
    // Check overall pattern validity
    is_valid := ab_xa_valid and bc_ab_valid
    
    [is_valid, d_price]

/**
 * Validate Crab pattern
 * 
 * @param x_price X point price
 * @param a_price A point price 
 * @param b_price B point price
 * @param c_price C point price
 * @param tolerance Tolerance for ratio validation
 * @returns Array containing [is_valid, d_price]
 */
validate_crab_pattern(float x_price, float a_price, float b_price, float c_price, float tolerance = DEFAULT_TOLERANCE) =>
    is_valid = false
    d_price = 0.0
    
    // Calculate key moves
    xa = a_price - x_price
    ab = b_price - a_price
    bc = c_price - b_price
    
    // Crab pattern key ratios:
    // - AB = 0.382-0.618 of XA
    // - BC = 0.382-0.886 of AB
    // - CD = 2.618-3.618 of BC
    // - D = 1.618 extension of XA
    
    ab_xa_ratio = calculate_ratio(xa, ab)
    bc_ab_ratio = calculate_ratio(ab, bc)
    
    // Validate AB/XA ratio (should be between 0.382-0.618)
    ab_xa_valid = validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_382, tolerance) or
                  validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_618, tolerance) or
                  (ab_xa_ratio > FIB_LEVEL_382 - tolerance and ab_xa_ratio < FIB_LEVEL_618 + tolerance)
    
    // Validate BC/AB ratio (should be between 0.382-0.886)
    bc_ab_valid = validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_382, tolerance) or
                  validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_886, tolerance) or
                  (bc_ab_ratio > FIB_LEVEL_382 - tolerance and bc_ab_ratio < FIB_LEVEL_886 + tolerance)
    
    // Calculate D point (1.618 extension of XA)
    d_price := a_price - xa * FIB_LEVEL_1618
    
    // Check overall pattern validity
    is_valid := ab_xa_valid and bc_ab_valid
    
    [is_valid, d_price]

/**
 * Validate Shark pattern
 * 
 * @param x_price X point price
 * @param a_price A point price 
 * @param b_price B point price
 * @param c_price C point price
 * @param tolerance Tolerance for ratio validation
 * @returns Array containing [is_valid, d_price]
 */
validate_shark_pattern(float x_price, float a_price, float b_price, float c_price, float tolerance = DEFAULT_TOLERANCE) =>
    is_valid = false
    d_price = 0.0
    
    // Calculate key moves
    xa = a_price - x_price
    ab = b_price - a_price
    bc = c_price - b_price
    
    // Shark pattern key ratios:
    // - AB = 0.5 of XA
    // - BC = 1.13-1.618 of AB
    // - CD = 1.618-2.24 of BC
    // - D = 0.886-1.13 of XA
    
    ab_xa_ratio = calculate_ratio(xa, ab)
    bc_ab_ratio = calculate_ratio(ab, bc)
    
    // Validate AB/XA ratio (should be around 0.5)
    ab_xa_valid = validate_harmonic_ratio(ab_xa_ratio, FIB_LEVEL_5, tolerance)
    
    // Validate BC/AB ratio (should be between 1.13-1.618)
    bc_ab_valid = validate_harmonic_ratio(bc_ab_ratio, 1.13, tolerance) or
                  validate_harmonic_ratio(bc_ab_ratio, FIB_LEVEL_1618, tolerance) or
                  (bc_ab_ratio > 1.13 - tolerance and bc_ab_ratio < FIB_LEVEL_1618 + tolerance)
    
    // Calculate D point (0.886-1.13 of XA)
    // Using average of the range for simplicity
    d_price := a_price - xa * FIB_LEVEL_886
    
    // Check overall pattern validity
    is_valid := ab_xa_valid and bc_ab_valid
    
    [is_valid, d_price] 