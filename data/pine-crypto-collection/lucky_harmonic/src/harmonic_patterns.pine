// @version=5
indicator("Harmonic Pattern Recognition", overlay=true)

// =====================================================
// Introduction
// =====================================================
/**
 * Harmonic Pattern Recognition Indicator
 * 
 * This indicator identifies and visualizes harmonic price patterns in financial markets.
 * It detects four common harmonic formations:
 * - Bat Pattern
 * - Butterfly Pattern 
 * - Crab Pattern
 * - Shark Pattern
 * 
 * Each pattern is validated against standard Fibonacci ratio requirements
 * and provides potential entry, stop loss, and target levels based on
 * harmonic trading principles.
 * 
 * Version: 0.0.1
 * Release Date: 2025-04-30
 */

// =====================================================
// Constants and Default Values
// =====================================================
/**
 * The following section defines all constants used throughout the indicator.
 * This includes version information, default values, Fibonacci levels,
 * pattern types, and threshold values for various calculations.
 */

// Version info
var string VERSION = "0.0.1"
var string VERSION_DATE = "2025-04-30"

/**
 * General default values used for initialization and fallback scenarios
 */
var float DEFAULT_TOLERANCE = 0.05
var float DEFAULT_VALUE_ON_ERROR = 0.0
var string DEFAULT_STRING_ON_ERROR = "N/A"
var int DEFAULT_LOOKBACK = 100
var int DEFAULT_MAX_PATTERNS = 10
var int MIN_BARS_FOR_PATTERN = 5

/**
 * Error handling constants
 */
var int MAX_RETRY_ATTEMPTS = 3
var int MAX_ERRORS_TO_TRACK = 50

/**
 * Standard Fibonacci levels used in harmonic pattern validation
 */
var float FIB_LEVEL_0 = 0.0
var float FIB_LEVEL_236 = 0.236
var float FIB_LEVEL_382 = 0.382
var float FIB_LEVEL_5 = 0.5
var float FIB_LEVEL_618 = 0.618
var float FIB_LEVEL_786 = 0.786
var float FIB_LEVEL_886 = 0.886
var float FIB_LEVEL_1 = 1.0
var float FIB_LEVEL_1272 = 1.272
var float FIB_LEVEL_1414 = 1.414
var float FIB_LEVEL_1618 = 1.618
var float FIB_LEVEL_2 = 2.0
var float FIB_LEVEL_2236 = 2.236
var float FIB_LEVEL_2618 = 2.618
var float FIB_LEVEL_3618 = 3.618
var float FIB_LEVEL_4236 = 4.236

/**
 * Pattern type identifiers
 */
var string PATTERN_TYPE_BAT = "Bat"
var string PATTERN_TYPE_BUTTERFLY = "Butterfly"
var string PATTERN_TYPE_CRAB = "Crab"
var string PATTERN_TYPE_SHARK = "Shark"

/**
 * Market type classifications for potential future use in optimizing pattern detection
 */
var string MARKET_TYPE_STOCK = "Stock"
var string MARKET_TYPE_FOREX = "Forex" 
var string MARKET_TYPE_CRYPTO = "Crypto"
var string MARKET_TYPE_COMMODITY = "Commodity"
var string MARKET_TYPE_UNKNOWN = "Unknown"

/**
 * Pattern direction constants
 */
var int PATTERN_DIRECTION_BULLISH = 1
var int PATTERN_DIRECTION_BEARISH = -1

/**
 * Quality threshold definitions for pattern evaluation
 */
var float QUALITY_HIGH = 0.8
var float QUALITY_MEDIUM = 0.5
var float QUALITY_LOW = 0.3

/**
 * Pattern age and minimum bar count constraints
 */
var int MAX_PATTERN_AGE = 50
var int MIN_PATTERN_BARS = 10

/**
 * Standard colors used for visualization
 */
var color BULLISH_COLOR = color.green
var color BEARISH_COLOR = color.red
var color NEUTRAL_COLOR = color.blue
var color WARNING_COLOR = color.yellow
var color ERROR_COLOR = color.red
var color INFO_COLOR = color.teal

// =====================================================
// Data Type Definitions
// =====================================================
/**
 * This section defines custom data types used throughout the indicator.
 * These structured types enhance code organization and maintainability.
 */

