//@version=5
strategy("TSI Strategy - Eterna MCP", 
         shorttitle="TSI",
         overlay=false,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         initial_capital=1000)

// ============================================
// PARAMETERS
// ============================================
longLength = input.int(25, "Long Length", minval=1)
shortLength = input.int(13, "Short Length", minval=1)
signalLength = input.int(13, "Signal Length", minval=1)
overboughtLevel = input.int(25, "Overbought", minval=10, maxval=50)
oversoldLevel = input.int(-25, "Oversold", minval=-50, maxval=-10)
leverageSize = input.float(5.0, "Leverage", minval=1, maxval=100)
positionSize = input.float(0.01, "Position Size", minval=0.001, maxval=1)

// ============================================
// TSI CALCULATION
// ============================================
// Price change
pc = ta.change(close)

// Double smoothed momentum
double_smoothed_pc = ta.ema(ta.ema(pc, longLength), shortLength)
double_smoothed_abs_pc = ta.ema(ta.ema(math.abs(pc), longLength), shortLength)

// TSI
tsi = 100 * (double_smoothed_pc / double_smoothed_abs_pc)

// Signal line
signal = ta.ema(tsi, signalLength)

// ============================================
// SIGNAL GENERATION
// ============================================
// Crossover signals
bullishCross = ta.crossover(tsi, signal)
bearishCross = ta.crossunder(tsi, signal)

// Zero-line cross (trend change)
bullishZero = ta.crossover(tsi, 0)
bearishZero = ta.crossunder(tsi, 0)

// Oversold/Overbought with momentum
bullishOB = tsi < oversoldLevel and tsi > tsi[1] and bullishCross
bearishOS = tsi > overboughtLevel and tsi < tsi[1] and bearishCross

// Combined entry signals
buySignal = (bullishCross and tsi < 0) or bullishOB
sellSignal = (bearishCross and tsi > 0) or bearishOS

// ============================================
// STRATEGY LOGIC
// ============================================
if buySignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    alert('{"action":"buy","symbol":"' + syminfo.ticker + '","size":' + str.tostring(positionSize) + ',"leverage":' + str.tostring(leverageSize) + '}', alert.freq_once_per_bar_close)

if sellSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","size":' + str.tostring(positionSize) + ',"leverage":' + str.tostring(leverageSize) + '}', alert.freq_once_per_bar_close)

// Exit on opposite signal
if sellSignal and strategy.position_size > 0
    strategy.close("Long")

if buySignal and strategy.position_size < 0
    strategy.close("Short")

// ============================================
// PLOTTING
// ============================================
plot(tsi, "TSI", color=color.blue, linewidth=2)
plot(signal, "Signal", color=color.orange, linewidth=1)
hline(overboughtLevel, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(oversoldLevel, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_solid, linewidth=2)

// Histogram
histogram = tsi - signal
plot(histogram, "Histogram", color=histogram > 0 ? color.green : color.red, style=plot.style_histogram, linewidth=2)

// Signals
plotshape(buySignal, "Buy", shape.triangleup, location.bottom, color.green, size=size.normal)
plotshape(sellSignal, "Sell", shape.triangledown, location.top, color.red, size=size.normal)

// Trend markers
plotshape(bullishZero, "Bull Trend", shape.circle, location.bottom, color.lime, size=size.tiny)
plotshape(bearishZero, "Bear Trend", shape.circle, location.top, color.orange, size=size.tiny)

// Background coloring
bgcolor(tsi > overboughtLevel ? color.new(color.red, 95) : 
        tsi < oversoldLevel ? color.new(color.green, 95) : na)
