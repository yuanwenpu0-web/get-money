//@version=5
strategy("MFI Strategy - Eterna MCP", 
         shorttitle="MFI",
         overlay=false,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=100,
         initial_capital=1000)

// ============================================
// PARAMETERS
// ============================================
mfiLength = input.int(14, "MFI Length", minval=1)
overboughtLevel = input.int(80, "Overbought", minval=50, maxval=100)
oversoldLevel = input.int(20, "Oversold", minval=0, maxval=50)
divergenceLookback = input.int(5, "Divergence Lookback", minval=3)
leverageSize = input.float(5.0, "Leverage", minval=1, maxval=100)
positionSize = input.float(0.01, "Position Size", minval=0.001, maxval=1)

// ============================================
// MFI CALCULATION
// ============================================
mfi = ta.mfi(close, mfiLength)

// ============================================
// SIGNAL GENERATION
// ============================================
// Standard overbought/oversold
bullishOB = ta.crossover(mfi, oversoldLevel)
bearishOS = ta.crossunder(mfi, overboughtLevel)

// Divergence detection
priceLow = ta.lowest(low, divergenceLookback)
priceHigh = ta.highest(high, divergenceLookback)
mfiLow = ta.lowest(mfi, divergenceLookback)
mfiHigh = ta.highest(mfi, divergenceLookback)

// Bullish divergence: price lower low, MFI higher low
bullishDiv = low == priceLow and mfi > mfiLow and mfi < oversoldLevel
// Bearish divergence: price higher high, MFI lower high
bearishDiv = high == priceHigh and mfi < mfiHigh and mfi > overboughtLevel

// Volume confirmation
avgVolume = ta.sma(volume, 20)
highVolume = volume > avgVolume * 1.5

// Combined signals
buySignal = (bullishOB or bullishDiv) and mfi < 50
sellSignal = (bearishOS or bearishDiv) and mfi > 50

// ============================================
// STRATEGY LOGIC
// ============================================
if buySignal and strategy.position_size == 0
    strategy.entry("Long", strategy.long)
    alert('{"action":"buy","symbol":"' + syminfo.ticker + '","size":' + str.tostring(positionSize) + ',"leverage":' + str.tostring(leverageSize) + '}', alert.freq_once_per_bar_close)

if sellSignal and strategy.position_size == 0
    strategy.entry("Short", strategy.short)
    alert('{"action":"sell","symbol":"' + syminfo.ticker + '","size":' + str.tostring(positionSize) + ',"leverage":' + str.tostring(leverageSize) + '}', alert.freq_once_per_bar_close)

// Exit on opposite signal
if sellSignal and strategy.position_size > 0
    strategy.close("Long")

if buySignal and strategy.position_size < 0
    strategy.close("Short")

// ============================================
// PLOTTING
// ============================================
plot(mfi, "MFI", color=color.blue, linewidth=2)
hline(overboughtLevel, "Overbought", color=color.red, linestyle=hline.style_dashed)
hline(oversoldLevel, "Oversold", color=color.green, linestyle=hline.style_dashed)
hline(50, "Midline", color=color.gray, linestyle=hline.style_dotted)

// Color gradient based on MFI value
mfiColor = mfi > overboughtLevel ? color.new(color.red, 80) : 
           mfi < oversoldLevel ? color.new(color.green, 80) : 
           color.new(color.gray, 90)
bgcolor(mfiColor)

plotshape(buySignal, "Buy", shape.triangleup, location.bottom, color.green, size=size.normal)
plotshape(sellSignal, "Sell", shape.triangledown, location.top, color.red, size=size.normal)

// Divergence markers
plotshape(bullishDiv, "Bullish Div", shape.diamond, location.bottom, color.lime, size=size.tiny)
plotshape(bearishDiv, "Bearish Div", shape.diamond, location.top, color.orange, size=size.tiny)

// Volume indicator
plot(highVolume ? 90 : na, "High Volume", color=color.yellow, style=plot.style_circles, linewidth=1)
