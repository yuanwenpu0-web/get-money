//@version=6
strategy("Martin Luk 强势回调 · 15m（本地适配）", overlay=true, initial_capital=10000,
     currency=currency.USD, pyramiding=0, margin_long=100, margin_short=100,
     commission_type=strategy.commission.percent, commission_value=0.04, slippage=0,
     process_orders_on_close=false, calc_on_every_tick=false, calc_on_order_fills=false)

// 使用：打开币安 U 本位永续的标准 15 分钟 K 线，复制至 Pine 编辑器并添加到图表。
// 上一根已收盘 4h EMA21/EMA50 和 ADX14 过滤，15m 上构造回调与确认，只做多。
// 参考本项目 2026-10-27 配置：ADX 27、浮盈 >1 ATR 激活、追踪距离 1.2 ATR、关闭 EMA 出场。
// 每根 15m 收盘产生订单，TradingView 默认在下一根可用价格撮合；无需开启 Bar Magnifier。
// 成本：手续费 0.04%/边已设于 strategy；本地有 0.02%/边百分比滑点，TradingView
// 的 slippage 只支持 tick，默认设为 0；成本过滤和仓位风险估算仍使用 0.02%/边。
// TradingView 采用其自身 OHLC 路径撮合，而本地同根止损/止盈均触发时止损优先；
// 下一根开盘跳空穿越止损/目标时本地会放弃开仓，TradingView 市价单可能仍会成交。
// 本脚本在信号收盘估算数量，不能按未知的下一根开盘价精确重算；成交量、指标初始值、
// 同账户多币竞争、资金费、强平、风险熔断、路由和实时持仓均可能造成差异。
// 仅适用于标准 15m K 线；不建议在 Heikin Ashi 等非标准图表上回测。

if not timeframe.isminutes or timeframe.multiplier != 15
    runtime.error("请将图表周期切换为 15 分钟。")
if not chart.is_standard
    runtime.error("请使用标准 K 线图。")

adxFilter = input.float(27.0, "4h ADX 门槛", minval=0, maxval=100)
minBars = input.int(8, "趋势起点至首次触及的最少 K 线", minval=0, maxval=200)
confirmBars = input.int(8, "回调确认窗口（K 线）", minval=1, maxval=200)
activationATR = input.float(1.0, "移动止损激活 ATR", minval=0.1)
trailATR = input.float(1.2, "移动止损距离 ATR", minval=0.1)
maxHoldBars = input.int(192, "最长持仓（15m K 线）", minval=1)
cooldownBars = input.int(10, "平仓后冷却（K 线）", minval=0)
minScore = input.float(0.55, "最低评分", minval=0.5, maxval=1)
heavyScore = input.float(0.75, "重仓评分", minval=0.5, maxval=1)
baseFraction = input.float(0.08, "基础仓位比例", minval=0, maxval=1)
maxFraction = input.float(0.35, "最大仓位比例", minval=0, maxval=1)
riskFraction = input.float(0.005, "单笔风险预算比例", minval=0.0001, maxval=0.05)
feeRate = 0.0004
slippageRate = 0.0002
roundTripCost = 2.0 * (feeRate + slippageRate)

// 提取完整的上一根 4h bar；[1] 与 lookahead_on 的组合防止高周期未来数据泄漏。
f_prev_adx() =>
    [plusDI, minusDI, value] = ta.dmi(14, 14)
    value[1]
[emaFast4h, emaSlow4h, adx4h] = request.security(syminfo.tickerid, "240",
     [ta.ema(close, 21)[1], ta.ema(close, 50)[1], f_prev_adx()], lookahead=barmerge.lookahead_on)
trendOK = not na(adx4h) and emaFast4h > emaSlow4h and adx4h >= adxFilter
ema9 = ta.ema(close, 9)
atr = ta.atr(14)

// AVWAP 依趋势布尔值切换重置，和回调状态共享当前趋势段。
var float segmentPV = 0.0
var float segmentVolume = 0.0
var int segmentStart = na
var int lastTouchBar = na
var int episodeStart = na
var float episodeLow = na
var bool episodeConfirmed = false
segmentChanged = barstate.isfirst or trendOK != trendOK[1]
if segmentChanged
    segmentPV := 0.0
    segmentVolume := 0.0
    segmentStart := bar_index
    lastTouchBar := na
    episodeStart := na
    episodeLow := na
    episodeConfirmed := false
segmentPV += hlc3 * math.max(nz(volume), 0.0)
segmentVolume += math.max(nz(volume), 0.0)
avwap = segmentVolume > 0 ? segmentPV / segmentVolume : na

// 与所有触及比较，而不是只和上一次“首次触及”比较。
touch = trendOK and bar_index - segmentStart >= minBars and close[1] >= ema9[1] and (low <= ema9 or (not na(avwap) and low <= avwap))
firstTouch = touch and (na(lastTouchBar) or bar_index - lastTouchBar >= minBars)
if touch
    lastTouchBar := bar_index
if firstTouch
    episodeStart := bar_index
    episodeLow := low
    episodeConfirmed := false
else if not na(episodeStart)
    episodeLow := math.min(episodeLow, low)
barsSinceTouch = na(episodeStart) ? na : bar_index - episodeStart
confirmRaw = trendOK and not na(barsSinceTouch) and barsSinceTouch >= 1 and barsSinceTouch <= confirmBars and close > open and close > close[1] and close > ema9 and close >= avwap
confirmed = confirmRaw and not episodeConfirmed
if confirmRaw
    episodeConfirmed := true

// 评分、止损距离、成本过滤和仓位规则与本地参数对应。
strength = math.max(0.0, math.min(1.0, (adx4h - adxFilter) / 15.0))
score = 0.5 + 0.5 * (0.25 + 0.75 * strength)
atrPct = atr / close
stopPct = math.max(math.max(math.max((close - episodeLow) / close, 0.0) + 0.0015, atrPct * 1.5), 0.0025)
targetPct = math.max(stopPct * 10.0, 0.005)
netRewardRisk = (targetPct - roundTripCost) / (stopPct + roundTripCost)
scoreSpan = math.max(heavyScore - minScore, 0.000001)
scoreFraction = math.max(0.0, math.min(1.0, (score - minScore) / scoreSpan))
positionFraction = score >= heavyScore ? maxFraction : baseFraction + scoreFraction * (maxFraction - baseFraction)
positionFraction := math.min(positionFraction, riskFraction / (stopPct + roundTripCost))
valid = confirmed and not na(atr) and atr > 0 and score >= minScore and atrPct <= 0.03 and atrPct >= 0.5 * roundTripCost and netRewardRisk >= 1.0

var float activeStop = na
var float activeTarget = na
var int lastExitBar = na
exitThisBar = ta.change(strategy.closedtrades) > 0
if exitThisBar
    lastExitBar := bar_index
    activeStop := na
    activeTarget := na
canEnter = strategy.position_size == 0 and not exitThisBar and (na(lastExitBar) or bar_index - lastExitBar >= cooldownBars)
if valid and canEnter and barstate.isconfirmed
    proposedStop = close * (1.0 - stopPct)
    proposedTarget = close * (1.0 + targetPct)
    // 已知信号收盘价时估算开仓与止损成交损失；真实开盘滑点未知。
    assumedEntry = close * (1.0 + slippageRate)
    assumedStopFill = proposedStop * (1.0 - slippageRate)
    lossRate = math.max(0.0, (assumedEntry - assumedStopFill) / assumedEntry) + feeRate * (1.0 + assumedStopFill / assumedEntry)
    riskNotional = strategy.equity * riskFraction / math.max(lossRate, 0.000000000001)
    orderNotional = math.min(math.min(strategy.equity * positionFraction, strategy.equity / (1.0 + feeRate)), riskNotional)
    if proposedStop > 0 and orderNotional >= 10.0 and assumedEntry > proposedStop and assumedEntry < proposedTarget
        activeStop := proposedStop
        activeTarget := proposedTarget
        strategy.entry("Long", strategy.long, qty=orderNotional / assumedEntry)
        alert("Martin Luk 15m 多头确认：" + syminfo.tickerid, alert.freq_once_per_bar_close)
        // 在开仓订单创建时一并挂保护单，确保开仓 K 线也有止损/止盈。
        strategy.exit("Exit", from_entry="Long", stop=activeStop, limit=activeTarget)

if strategy.position_size > 0
    if close - strategy.position_avg_price > atr * activationATR
        activeStop := math.max(activeStop, close - atr * trailATR)
    // 更新的止损在下一根 K 线生效，止损只上移。
    strategy.exit("Exit", from_entry="Long", stop=activeStop, limit=activeTarget)
    // 计划下一根开盘强制退出，按 15m 的 192 根即 48 小时。
    if bar_index - strategy.opentrades.entry_bar_index(0) >= maxHoldBars - 1
        strategy.close("Long", comment="48h time stop")

plot(ema9, "EMA9", color=color.orange)
plot(trendOK ? avwap : na, "强势段 AVWAP", color=color.aqua, linewidth=2, style=plot.style_linebr)
plot(strategy.position_size > 0 ? activeStop : na, "移动 / 结构止损", color=color.red, style=plot.style_linebr)
plot(strategy.position_size > 0 ? activeTarget : na, "固定目标", color=color.green, style=plot.style_linebr)
plotshape(valid and canEnter, title="确认信号", style=shape.triangleup, location=location.belowbar, color=color.lime, size=size.tiny)
